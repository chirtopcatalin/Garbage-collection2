@model IEnumerable<GarbageCollection.Models.BinModel>

@{
    ViewBag.Title = "Delete Bin";
}

<h2>@ViewBag.Title</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No bins found.</div>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Id</th>
                <th>Bin Code</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bin in Model)
            {
                <tr>
                    <td>@bin.Id</td>
                    <td>@bin.Code</td>
                    <td>
                        @using (Html.BeginForm("DeleteBin", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", bin.Id)
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this bin?');">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
