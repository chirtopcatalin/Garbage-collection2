@model IEnumerable<GarbageCollection.Models.CitizenModel>

@{
    ViewBag.Title = "Delete Citizen";
}

<h2>@ViewBag.Title</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No citizens found.</div>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>CNP</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var citizen in Model)
            {
                <tr>
                    <td>@citizen.Id</td>
                    <td>@citizen.FirstName</td>
                    <td>@citizen.LastName</td>
                    <td>@citizen.Cnp</td>
                    <td>@citizen.Email</td>
                    <td>
                        @using (Html.BeginForm("DeleteCitizen", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", citizen.Id)
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this citizen and unassign all bins?');">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
