@model IEnumerable<dynamic>

@{
    ViewBag.Title = "Unassign Bin";
}

<h2>Unassign Bin</h2>

<table class="table">
    <thead>
        <tr>
            <th>Bin Code</th>
            <th>Citizen</th>
            <th>Address</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdBin</td>
                <td>@item.CitizenName</td>
                <td>@item.Address</td>
                <td>
                    <form asp-action="UnassignBin" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger">Unassign</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
