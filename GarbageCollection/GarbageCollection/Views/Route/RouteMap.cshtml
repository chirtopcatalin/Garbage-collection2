@model IEnumerable<GarbageCollection.Models.CollectionModel>
@using Newtonsoft.Json

@{
    var pointsJson = Newtonsoft.Json.JsonConvert.SerializeObject(
        Model.Select(p => new
        {
            lat = double.Parse(p.latitude),
            lng = double.Parse(p.longitude),
            time = p.CollectionTime.ToString("yyyy-MM-dd HH:mm:ss"),
            address = p.address,
            car = p.car_number
        })
    );
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Route Map</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <style>
        #map { height: 600px; width: 100%; }
    </style>
</head>
<body>
    <h2>Collection Route for @Model.FirstOrDefault()?.CollectionTime.ToString("yyyy-MM-dd")</h2>
    <div id="map"></div>

    <script>
        var map = L.map('map').setView([45.75, 24.15], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var points = @Html.Raw(pointsJson);
        var latlngs = [];

        points.forEach(function(pt) {
            var marker = L.marker([pt.lat, pt.lng]).addTo(map);
            marker.bindPopup(
                '<strong>Car:</strong> ' + pt.car + '<br>' +
                '<strong>Time:</strong> ' + pt.time + '<br>' +
                '<strong>Address:</strong> ' + pt.address
            );
            latlngs.push([pt.lat, pt.lng]);
        });

        if (latlngs.length > 1) {
            L.polyline(latlngs, { weight: 3 }).addTo(map);
            map.fitBounds(latlngs);
        } else if (latlngs.length === 1) {
            map.setView(latlngs[0], 14);
        }
    </script>
</body>
</html>